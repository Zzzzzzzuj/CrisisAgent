# Runtime mode: mock is offline-safe; llm uses the OpenAI-compatible client.
AGENT_MODE=mock

# OpenAI-compatible LLM configuration.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# RAG embedding model: hash is default/offline-safe; bge requires requirements-bge.txt.
EMBEDDING_MODEL=hash

# Checkpoint persistence. json is local/offline-safe; postgres uses SQLAlchemy repositories.
CHECKPOINT_STORAGE=json
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/crisis_agent

# Auth and RBAC. Keep disabled for local demo mode; set a strong secret before enabling.
AUTH_ENABLED=false
SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# FastAPI CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API base URL for production builds or non-proxy deployments.
VITE_API_BASE_URL=http://127.0.0.1:8000
