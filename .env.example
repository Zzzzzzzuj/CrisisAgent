# Runtime mode: mock is offline-safe; llm uses the OpenAI-compatible client.
AGENT_MODE=mock

# OpenAI-compatible LLM configuration.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5

# RAG embedding model: hash is default/offline-safe; bge requires requirements-bge.txt.
EMBEDDING_MODEL=hash

# Vector retrieval backend. json is default/offline-safe; pgvector requires PostgreSQL + vector extension.
VECTOR_BACKEND=json
PGVECTOR_INDEX_TYPE=ivfflat
PGVECTOR_DISTANCE=cosine

# Checkpoint persistence. json is local/offline-safe; postgres uses SQLAlchemy repositories.
CHECKPOINT_STORAGE=json
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/crisis_agent

# Async task queue. inprocess is local/offline-safe; rq requires Redis and scripts/run_rq_worker.py.
TASK_QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=crisisagent
RQ_JOB_TIMEOUT_SECONDS=900

# Auth/RBAC. Keep false for local demo mode; true requires SECRET_KEY and users in database.
AUTH_ENABLED=false
SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=480

# FastAPI CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API base URL for production builds or non-proxy deployments.
VITE_API_BASE_URL=http://127.0.0.1:8000
